# ==================== Configuración de Base de Datos ====================
DB_DRIVER=mysql+pymysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=truekealo_db

# ==================== Configuración de Seguridad ====================
# IMPORTANTE: Genera una clave secreta única para producción
# Puedes generarla con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=tu_secret_key_super_segura_aqui_cambiar_en_produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== Configuración de la Aplicación ====================
APP_NAME=Truekealo API
APP_VERSION=1.0.0
DEBUG=True

# ==================== Configuración de CORS ====================
# Separar múltiples orígenes con comas
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:8000,http://127.0.0.1:5500,http://127.0.0.1:8000
CORS_ALLOW_CREDENTIALS=True

# ==================== Configuración de Email (Opcional) ====================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_email@gmail.com
# SMTP_PASSWORD=tu_password_de_aplicacion
# EMAIL_FROM=noreply@truekealo.com
